# Preparation template only; do not put real secrets in this file or in git.
# Copy outside the checkout; the safe wrapper maps the four API secret mounts.
# ENVIRONMENT is intentionally absent: the application does not read it as a switch.

# NEW infrastructure-only Compose inputs (not application variables).
# Use an absolute path outside the checkout. /run is volatile; repopulate securely
# on boot from an encrypted, separately held source before starting containers.
SELFHOST_SECRETS_DIR=/run/proptech-selfhost/secrets
SELFHOST_TLS_DIR=/run/proptech-selfhost/tls
SELFHOST_RUNTIME_ENV_FILE=/etc/proptech-selfhost/runtime.env
# Backend: named local tag@sha256:digest computed/reviewed from target build;
# a bare sha256 image ID is not accepted by BuildKit FROM. Proxy: registry digest.
SELFHOST_BACKEND_IMAGE=
SELFHOST_PROXY_IMAGE=

# Supported core application settings. preview intentionally enforces production
# guardrails. Do not use development/test to bypass missing usage configuration.
APP_ENV=preview
APP_RUNTIME=standard
MAINTENANCE_MODE=false
# Dummy non-local origins satisfy syntax only; replace with approved private names.
PUBLIC_APP_BASE_URL=https://staging.example.invalid
BACKEND_PUBLIC_URL=https://api.staging.example.invalid
CORS_ALLOWED_ORIGINS=https://staging.example.invalid
API_ALLOWED_HOSTS=localhost,127.0.0.1,api.staging.example.invalid
POSTGRES_SSLMODE=verify-full
RELEASE_VERSION=selfhost-preparation
API_CONTRACT_VERSION=api-contract-v1
SCHEMA_VERSION=schema-007
RELEASE_COMMIT_SHA=
BUILD_TIMESTAMP=

# Secret names below are supported application variables. Leave empty here.
# Runtime wrapper sets these from app_database_url, usage_database_url,
# usage_peer_hmac_key, pilot_session_signing_key files respectively.
# DATABASE_URL targets fresh postgres_app/proptech_app as app_runtime only.
# API_USAGE_DATABASE_URL targets postgres_usage/proptech_api_usage directly as
# proptech_usage_runtime_v1; no legacy/application fallback, admin, or SET ROLE.
DATABASE_URL=
API_USAGE_DATABASE_URL=
API_USAGE_PEER_HMAC_KEY=
PILOT_SESSION_SIGNING_KEY=
API_USAGE_GUARD_MODE=postgres
API_USAGE_LEDGER_REQUIRED=true
API_USAGE_FLUSH_SECONDS=10
ANTI_ABUSE_ENFORCEMENT_MODE=local_only
# local_only is the existing process admission implementation; durable quota
# enforcement above remains mandatory and is separate. No Redis mode exists.
PILOT_ADMIN_TOKEN=
PILOT_REVIEW_TOKEN=
METRICS_SCRAPE_TOKEN=

# Existing optional Supabase asymmetric JWT identity verifier; does not create
# or migrate an Auth database. VNext URL has no DATABASE_URL fallback and must
# authenticate directly as vnext_api. Keep rollout flags off for private rehearsal.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
VNEXT_DATABASE_URL=
FEATURE_IDENTITY_V1=false
FEATURE_LEGACY_CASE_IMPORT_V1=false
FEATURE_CASE_PARCEL_SET_V1=false

# Existing separate read-model databases; do not point at a legacy URL or at
# the usage cluster. Leave unavailable until independently reviewed/provisioned.
VALUATION_DATABASE_URL=
VALUATION_DEMO_MODE=false
PLVR_DATA_BACKEND=blue
COMPACT_GREEN_DATABASE_URL=

# Optional server-side providers. Empty values prevent credentialed rehearsal.
# Do not reuse frontend NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY on the backend.
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
EARTH_ENGINE_SATELLITE_REFERENCE_V1=false
EARTH_ENGINE_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS is Google's ADC file-path contract, not a new
# app switch. Leave empty until a separately mounted scoped credential exists.
GOOGLE_APPLICATION_CREDENTIALS=
TGOS_APP_ID=
TGOS_API_KEY=
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
COMMUTE_REFRESH_TOKEN=
# NLSC production-like gateway requires HTTPS/global DNS or IP plus actual
# Taiwan fixed-IP/residency verification; syntax alone never establishes that.
NLSC_GATEWAY_BASE_URL=
NLSC_GATEWAY_CLIENT_TOKEN=
TAIPEI_PLANNING_READ_V1=false
TAIPEI_PLANNING_SOURCE_MODE=manual_evidence

# Existing optional R2 object runtime; source remains authoritative/unmodified.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
GSMMA_GEOLOGICAL_SENSITIVITY_DATASET_VERSION=
NLSC_VILLAGE_BOUNDARY_ARTIFACT_PATH=
NLSC_VILLAGE_BOUNDARY_ARTIFACT_SHA256=
NLSC_VILLAGE_BOUNDARY_SOURCE_VINTAGE=
NLSC_VILLAGE_BOUNDARY_SOURCE_PROVENANCE=
NLSC_VILLAGE_BOUNDARY_R2_KEY=

# No trusted-proxy or ENVIRONMENT variable is invented. Uvicorn keeps
# --no-proxy-headers; preserve Host at the proxy. Ingress identity design must be
# reviewed before multi-user public traffic, since peer identity is transport-based.
# Administrative bootstrap URL is deliberately absent from API runtime settings:
# only usage_ops mounts usage_bootstrap_database_url -> API_USAGE_BOOTSTRAP_DATABASE_URL.
