# Optional. The MVP uses a deterministic Chinese fallback explanation without this key.
OPENAI_API_KEY=

# Comma-separated frontend origins. Defaults to localhost origins when empty.
CORS_ORIGINS=

# Optional Google Places / Geocoding backend adapter. Falls back to mock data when empty.
# Server-only: never reuse this value as NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY.
GOOGLE_MAPS_API_KEY=
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
TGOS_API_KEY=
TGOS_APP_ID=

# Optional backend-only NLSC gateway. In production, use a controlled HTTPS
# domain resolving to the fixed Taiwan public IP (or a public IP with valid TLS).
# Domain/IP syntax does not prove Taiwan residency; verify it before NLSC submission.
# Keep unset until provisioned. Never expose the client token to the browser.
NLSC_GATEWAY_BASE_URL=
NLSC_GATEWAY_CLIENT_TOKEN=

# Optional future Supabase/Postgres valuation database. Falls back safely when unset.
VALUATION_DATABASE_URL=

# VNext server-side Supabase Auth verification. SUPABASE_JWT_ISSUER may be
# omitted when SUPABASE_URL is set; the expected audience defaults to
# "authenticated". identity_v1 is rollout-only and remains off by default.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
FEATURE_IDENTITY_V1=false
FEATURE_LEGACY_CASE_IMPORT_V1=false
FEATURE_CASE_PARCEL_SET_V1=false

# Taipei statutory-planning V1 normalizes user-provided official-document
# references only. The rollout flag is off by default; manual_evidence is the
# sole supported source mode and performs no provider or retrieval call.
TAIPEI_PLANNING_READ_V1=false
TAIPEI_PLANNING_SOURCE_MODE=manual_evidence
