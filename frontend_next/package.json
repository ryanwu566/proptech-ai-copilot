{
  "name": "proptech-ai-copilot-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "npm run build:e2e && node e2e/run-e2e.cjs",
    "test:e2e:i18n": "npm run build:e2e && node e2e/run-e2e.cjs e2e/i18n.spec.ts",
    "test:e2e:navigation": "npm run build:e2e && node e2e/run-e2e.cjs e2e/navigation.spec.ts",
    "test:e2e:speech": "npm run build:e2e && node e2e/run-e2e.cjs e2e/speech.spec.ts",
    "test:e2e:hosted": "playwright test --config=playwright.hosted.config.ts",
    "test:e2e:real-provider": "npm run build:e2e && node e2e/run-e2e.cjs --config=playwright.real-provider.config.ts --workers=1"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.2.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10",
    "eslint": "^9.39.5",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  }
}
