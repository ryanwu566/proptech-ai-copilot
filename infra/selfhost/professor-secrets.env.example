# Nonsecret settings ONLY. Merge reviewed settings; do not overwrite Stage 1 paths,
# CORS/base URLs or release metadata. Never put credential names/values here.
# Set PROFESSOR_SERVER_API_IMAGE only in compose.env after verifying the new
# immutable image identity; it is required by the prepared Stage 2 override.
APP_ENV=preview
POSTGRES_SSLMODE=verify-full
PGSSLROOTCERT=/run/selfhost-ca/ca.crt
PLVR_DATA_BACKEND=blue
VALUATION_DEMO_MODE=false
PLVR_SERVING_EXCLUSIONS_ENABLED=true
WRA_FLOOD_LOCAL_ROOT=/srv/proptech/datasets/wra/flood/v1
EARTH_ENGINE_SATELLITE_REFERENCE_V1=false
FEATURE_IDENTITY_V1=false
FEATURE_LEGACY_CASE_IMPORT_V1=false
FEATURE_CASE_PARCEL_SET_V1=false
TAIPEI_PLANNING_READ_V1=false
ANTI_ABUSE_MARKET_OPS_DISABLED=true
ANTI_ABUSE_GEOCODING_DISABLED=true
ANTI_ABUSE_PLACES_DISABLED=true
ANTI_ABUSE_ROUTES_DISABLED=true
ANTI_ABUSE_SATELLITE_DISABLED=true
ANTI_ABUSE_LOCATION_DISABLED=true
ANTI_ABUSE_PARCEL_DISABLED=true
ANTI_ABUSE_ARDSWC_DISABLED=true
ANTI_ABUSE_LIQUEFACTION_DISABLED=true
ANTI_ABUSE_NLSC_DISABLED=true
ANTI_ABUSE_TGOS_DISABLED=true
