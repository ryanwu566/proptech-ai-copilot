{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proptech:ml:release-ledger-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_dataset_id",
    "historical_evidence_sha256",
    "inventory_scope",
    "availability_policy",
    "releases"
  ],
  "properties": {
    "schema_version": {
      "const": "plvr-ml-release-ledger-v1"
    },
    "source_dataset_id": {
      "const": "moi-plvr-existing-sale-main-25119"
    },
    "historical_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inventory_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "availability_policy": {
      "type": "string",
      "minLength": 1
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_release_id",
          "release_label",
          "release_kind",
          "source_url",
          "catalog_url",
          "source_dataset_id",
          "effective_data_period",
          "original_archive_filename",
          "local_archive_filename",
          "archive_sha256",
          "declared_archive_bytes",
          "retrieved_at",
          "retrieval_evidence_status",
          "source_release_available_at",
          "availability_evidence",
          "publication_date",
          "publication_precision",
          "parser_version",
          "transform_version",
          "import_batch_id",
          "raw_row_count",
          "accepted_row_count",
          "rejected_row_count",
          "supersedes_release_id",
          "supersession_evidence",
          "recovery_status",
          "recovery_reason",
          "remote_recoverability",
          "historical_source_status",
          "status",
          "members"
        ],
        "properties": {
          "source_release_id": {
            "type": "string",
            "minLength": 1
          },
          "release_label": {
            "type": "string",
            "minLength": 1
          },
          "release_kind": {
            "enum": [
              "season",
              "history",
              "current"
            ]
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://plvr\\.land\\.moi\\.gov\\.tw/"
          },
          "catalog_url": {
            "const": "https://data.gov.tw/dataset/25119"
          },
          "source_dataset_id": {
            "const": "moi-plvr-existing-sale-main-25119"
          },
          "effective_data_period": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "basis"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "original_archive_filename": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "local_archive_filename": {
            "type": "string",
            "minLength": 1
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "declared_archive_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "retrieved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrieval_evidence_status": {
            "type": "string",
            "minLength": 1
          },
          "source_release_available_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "availability_evidence": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "locator",
                  "version"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "publication_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "publication_precision": {
            "enum": [
              "day",
              "unknown"
            ]
          },
          "parser_version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "transform_version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "import_batch_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "raw_row_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "accepted_row_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "rejected_row_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "supersedes_release_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "supersession_evidence": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "locator",
                  "version"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "recovery_status": {
            "enum": [
              "AVAILABLE",
              "PARTIALLY AVAILABLE",
              "MISSING",
              "UNKNOWN"
            ]
          },
          "recovery_reason": {
            "type": "string",
            "minLength": 1
          },
          "remote_recoverability": {
            "enum": [
              "AVAILABLE",
              "PARTIALLY AVAILABLE",
              "MISSING",
              "UNKNOWN"
            ]
          },
          "historical_source_status": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "metadata_only",
              "bytes_pending_semantic_review",
              "verified_staging"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "member_name",
                "member_sha256",
                "schema_sha256",
                "raw_row_count",
                "accepted_row_count",
                "rejected_row_count"
              ],
              "properties": {
                "member_name": {
                  "type": "string",
                  "minLength": 1
                },
                "member_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "schema_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "raw_row_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "accepted_row_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "rejected_row_count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
