{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "ml-data-gate-bundle-v1"
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "observation_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_archive_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "release_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "local_recovered_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "official_url": {
            "type": "string",
            "maxLength": 2048
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "byte_size",
          "local_recovered_path",
          "official_url",
          "release_version",
          "retrieved_at",
          "sha256",
          "source_archive_id"
        ]
      }
    },
    "receipts": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object"
      }
    },
    "execution_observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "cutoff",
    "observation_at",
    "receipts",
    "sources",
    "version"
  ]
}
